{
  "name": "virtual-instruments",
  "version": "1.0.0",
  "description": "14 Web Audio percussion instruments with matching 1024x1024 PNG artwork. Synthesised at runtime - no sample files.",
  "source": "Extracted from the Virtual Drum Kit app (Claude Apps/virtual-drum-kit/index.html), then revised - see README.md, Sound revision 1.1.",
  "library": "js/virtual-instruments.js",
  "globalName": "VirtualInstruments",
  "imageDir": "images",
  "imageSize": {
    "width": 1024,
    "height": 1024,
    "format": "png",
    "transparentBackground": true
  },
  "noteIntervals120Bpm": [
    0,
    2000,
    1000,
    500,
    250,
    125,
    62.5
  ],
  "noteLabels": [
    "off",
    "whole",
    "half",
    "quarter",
    "eighth",
    "sixteenth",
    "thirtysecond"
  ],
  "measurement": {
    "method": "Rendered offline at 48 kHz and analysed. loudnessDb is the peak A-weighted level over a sliding 150 ms window (roughly how the ear integrates a percussive hit); peak is absolute sample peak, where 1.0 is full scale; decaySec is time to -60 dB; centroidHz is the spectral centroid.",
    "note": "loudnessDb is a relative scale for comparing instruments within this kit, not an absolute SPL. Bass reads low because A-weighting deliberately discounts 50-60 Hz - it is felt more than heard, and matching it to the others would make it overwhelming."
  },
  "playOptions": {
    "is32nd": "boolean - use the shortened fast-repeat envelope (softer attack, tighter decay). All instruments.",
    "repeatInterval": "number (ms) - repeat rate this hit belongs to. Any value <= 70 implies is32nd. All instruments.",
    "strokeType": "guiro only - \"short\" | \"long\" | \"flick\" | \"part2\"",
    "accentFirst": "guiro only - boolean, accent the first ratchet of a long scrape",
    "strikePosition": "cowbell only - 0.0 (mouth, ringing) to 1.0 (shoulder, choked). Default 0.2",
    "gestureType": "tambourine only - \"hit\" (single strike) | \"shake\" (jingle wash). Defaults to \"shake\" when is32nd"
  },
  "kitOptions": {
    "audioContext": "supply an existing AudioContext (or an OfflineAudioContext, for offline rendering/tests)",
    "destination": "AudioNode to output into, instead of audioContext.destination",
    "volume": "initial master gain, default 1",
    "fftSize": "analyser FFT size, default 64",
    "softClip": "set false to remove the master soft-clip safety stage (default on; see README)"
  },
